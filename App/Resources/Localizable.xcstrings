      }
    },
    "This device doesn't report a USB vendor/product ID, so this profile may not auto-match it again later." : {
      "localizations" : {
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Este dispositivo no reporta un ID de fabricante/producto USB, así que este perfil podría no volver a coincidir automáticamente más adelante." } }
      }
    },
    "This looks like a multi-line paste. Each line will be sent as typed — review it before it goes to the device." : {
      "localizations" : {
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Esto parece un pegado de varias líneas. Cada línea se enviará tal cual — revísala antes de que vaya al dispositivo." } }
      }
    },
