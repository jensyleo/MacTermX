{
  "sourceLanguage" : "en",
  "strings" : {
    "Add" : {
      "localizations" : {
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Agregar" } }
      }
    },
    "A file transfer is in progress on this tab. Closing it now will abort the transfer." : {
      "localizations" : {
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Hay una transferencia de archivo en curso en esta pestaña. Cerrarla ahora la interrumpirá." } }
      }
    },
    "A persistent PRODUCTION banner will show in the console — this is a labeling aid only, not an access control." : {
      "localizations" : {
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Se mostrará un aviso persistente de PRODUCCIÓN en la consola — es solo una ayuda visual, no un control de acceso." } }
      }
    },
